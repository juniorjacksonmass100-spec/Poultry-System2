# Supabase Configuration (Frontend)
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server-side Supabase Service Role Key (Used only for administrative operations like Edge Functions or reset scripts)
# NEVER prefix with VITE_ and NEVER expose to the browser!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Gemini AI / App URL
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"


# Optional: your live website address. Used as the link target in password-reset emails,
# and REQUIRED for password reset to work from inside the Android app.
# VITE_APP_URL="https://your-app.onrender.com"
